(text "COMPUTE MODULE 5 / OPTIONAL HOST IO" (at 22 18 0) (effects (font (size 2 2)) (justify left)) (uuid 2ec1d2e6-01f9-5c4d-b395-bd4d13fb3a28))
(text "J5 contacts 1-100; J6 contacts 1-100 = module pins 101-200.\nGPIO_VREF = CM5 3.3V. GPIO2/3 have internal 1.8k pull-ups.\neMMC/Wi-Fi module only; preimage on a separate CM5IO board." (at 22 242 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid ca5ca0f6-baee-53d5-a608-b15556a1ff49))
(text "J7/J8/J9 are optional user-fitted headers; 3.3V host logic.\nJ6 may be omitted with all four module standoffs fitted.\nBoth CM5 3.3V output contacts supply HOST3V3." (at 220 242 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid c98757c8-5265-58a8-b71b-3cdb95b5547a))
)
